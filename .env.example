# Shared
APP_ENV=local
LLM_PROVIDER=auto
TEMPERATURE=0.2
RAG_TOP_K=4

# Local mode (APP_ENV=local)
OLLAMA_MODEL=llama3.2:latest
EMBED_MODEL=nomic-embed-text
LOCAL_FAISS_PATH=app/rag/faiss_index
KB_FOLDER=kb_pdfs

# Groq LLM option (set LLM_PROVIDER=groq to use this)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Cloud mode (APP_ENV=cloud)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=capstone_kb
EMBED_DIM=768
SYNTHETIC_DATA_PATH=data/synthetic_dataset.jsonl
INCLUDE_PDF_IN_INGEST=true
INCLUDE_SYNTHETIC_IN_INGEST=true
INCLUDE_SQLITE_IN_INGEST=true
CLOUD_REFRESH_SOURCE_TYPES=true
